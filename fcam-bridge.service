[Unit]
Description=FCAM bridge: Babble face tracker on /dev/ttyACM0 -> Baballonia over UDP
Documentation=https://github.com/CyrusOtter/Babble-Bridge

[Service]
ExecStart=/usr/bin/python3 %h/fcam/fcam_bridge.py --listen 0.0.0.0:8555 --stats 60
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=default.target
