# Babble face tracker (Espressif USB Serial/JTAG, 303a:1001) on a Steam Frame.
#
# The stock Steam Frame kernel has no cdc-acm driver: load the locally built
# module when the tracker appears (see build-cdc-acm.sh), let the logged-in user
# open the port, and add the stable name /dev/babble-tracker. The bridge finds
# the port by USB id on its own, so the name is a convenience. Install as root:
#
#   sudo install -m 0644 90-babble-tracker.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#
# /etc is a persistent overlay on SteamOS, so this survives reboots but not OS
# updates that ship a new kernel (rebuild cdc-acm.ko with build-cdc-acm.sh).
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="303a", ATTR{idProduct}=="1001", RUN+="/usr/bin/insmod /home/steamos/cdc-acm/cdc-acm.ko"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", TAG+="uaccess", MODE="0660", GROUP="uucp", SYMLINK+="babble-tracker"
