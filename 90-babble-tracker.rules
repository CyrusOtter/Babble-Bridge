# Babble face tracker (Espressif USB Serial/JTAG, 303a:1001) on a Steam Frame.
#
# The stock Steam Frame kernel ships without the cdc-acm driver, so the tracker
# enumerates but no /dev/ttyACM0 appears. This rule loads a locally built
# cdc-acm.ko when the tracker is plugged in and lets the logged-in user open the
# port. Install as root:
#
#   sudo install -m 0644 90-babble-tracker.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#
# /etc is a persistent overlay on SteamOS, so this survives reboots but not OS
# updates that ship a new kernel (rebuild cdc-acm.ko against the new headers).
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="303a", ATTR{idProduct}=="1001", RUN+="/usr/bin/insmod /home/steamos/cdc-acm/cdc-acm.ko"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", TAG+="uaccess", MODE="0660", GROUP="uucp"
