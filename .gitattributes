# Everything in this repository runs on Linux (the headset). Keep LF even in a Windows checkout
# with core.autocrlf=true: root/ holds extension-less scripts that run as root, and a CRLF there
# breaks them (install-cdc-acm-loader.sh refuses such files).
* text=auto eol=lf
*.sh text eol=lf
root/* text eol=lf
*.service text eol=lf
*.rules text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.vrmanifest text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.png binary
